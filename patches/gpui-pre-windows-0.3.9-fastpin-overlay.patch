+    // FastPin overlay patch: the freeze frame is a second DComp visual that
+    // sits BELOW the GPUI UI visual. Capture renders its still frame into a
+    // dedicated swap chain and parks it here so the overlay draws on top of
+    // it while real GPUI frames are suspended.
+    pub fn set_freeze_swap_chain(&self, swap_chain: Option<&IDXGISwapChain1>) -> Result<()> {
+        unsafe {
+            match swap_chain {
+                Some(swap) => self.freeze_visual.SetContent(swap)?,
+                None => self.freeze_visual.SetContent(None::<&windows::core::IUnknown>)?,
+            }
+            self.comp_device.Commit()?;
+        }
+        Ok(())
+    }
+
+    pub fn wait_for_commit_completion(&self) -> Result<()> {
+        unsafe { self.comp_device.WaitForCommitCompletion()? };
+        Ok(())
+    }
