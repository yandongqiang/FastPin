+# FastPin overlay patch: the patched-in GPU APIs cross the crate boundary into
+# applications that compile against `windows` 0.61, so the patched trait
+# methods use a renamed 0.61 dependency; the COM pointers themselves are the
+# same objects, converted via `as_raw`/`from_raw` where the 0.62 renderer
+# needs them.
+[target.'cfg(target_os = "windows")'.dependencies.windows61]
+package = "windows"
+version = "0.61"
+features = [
+    "Win32_Foundation",
+    "Win32_Graphics_Direct3D11",
+    "Win32_Graphics_Dxgi",
+]
+
 [target.'cfg(target_os = "windows")'.dependencies.windows-core]
 version = "0.62"
 
