+    // FastPin overlay patch: GPU introspection and lifecycle hooks.
+    /// Current GPU device generation. Increments when DirectX devices are
+    /// recreated after a reset.
+    #[cfg(target_os = "windows")]
+    pub fn gpu_generation(&self) -> u64 {
+        self.platform.gpu_generation()
+    }
+
+    /// Adapter LUID `(LowPart, HighPart)` of the GPUI DirectX device, if available.
+    #[cfg(target_os = "windows")]
+    pub fn adapter_luid(&self) -> Option<(u32, i32)> {
+        self.platform.adapter_luid()
+    }
+
+    /// Temporarily borrows the GPUI Direct3D device and immediate context on the main thread.
+    ///
+    /// Returns `None` if the devices are unavailable. Do not clone the immediate context out of
+    /// the closure for long-term storage.
+    #[cfg(target_os = "windows")]
+    pub fn with_gpu_context<R>(
+        &mut self,
+        f: impl FnOnce(
+            &windows61::Win32::Graphics::Direct3D11::ID3D11Device,
+            &windows61::Win32::Graphics::Direct3D11::ID3D11DeviceContext,
+        ) -> R,
+    ) -> Option<R> {
+        let mut result = None;
+        let mut f = Some(f);
+        let ok = self.platform.with_gpu_context(&mut |device, context| {
+            if let Some(f) = f.take() {
+                result = Some(f(device, context));
+            }
+        });
+        if ok { result } else { None }
+    }
+
+    /// Registers a callback that runs on the main thread before DirectX devices are recreated.
+    #[cfg(target_os = "windows")]
+    pub fn on_gpu_reset_begin(&self, callback: impl FnMut() + 'static) {
+        self.platform.on_gpu_reset_begin(Box::new(callback));
+    }
+
+    /// Registers a callback that runs on the main thread after the DirectX
+    /// devices were recreated. Receives the new `gpu_generation`.
+    #[cfg(target_os = "windows")]
+    pub fn on_gpu_reset_end(&self, callback: impl FnMut(u64) + 'static) {
+        self.platform.on_gpu_reset_end(Box::new(callback));
+    }
+
+    /// Releases the platform's DirectX devices (and stops vsync). Only valid
+    /// while no window is open.
+    pub fn release_gpu_devices(&self) {
+        self.platform.release_gpu_devices();
+    }
