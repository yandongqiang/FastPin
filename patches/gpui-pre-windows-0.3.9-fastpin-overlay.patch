+            &windows61::Win32::Graphics::Direct3D11::ID3D11Device,
+            &windows61::Win32::Graphics::Direct3D11::ID3D11DeviceContext,
+        ),
+    ) -> bool {
+        use windows61::core::Interface as _;
+        let state = self.inner.state.directx_devices.borrow();
+        let Some(devices) = state.as_ref() else {
+            return false;
+        };
+        if !devices.is_available() {
+            return false;
+        }
+        // `from_raw` transfers ownership of the reference (no AddRef) and the
+        // wrapper releases it on drop, so pin them for the duration of the
+        // borrow and let the platform's own references keep the objects alive.
+        let device = std::mem::ManuallyDrop::new(unsafe {
+            windows61::Win32::Graphics::Direct3D11::ID3D11Device::from_raw(devices.device.as_raw())
+        });
