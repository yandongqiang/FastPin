+# FastPin overlay patch: the patched-in GPU APIs are part of the public surface,
+# so their signatures must use the same `windows` major that applications
+# compile against (0.61). Type identity across the boundary comes from the
+# crate version, not the feature set, so these types unify with the app's.
+[target.'cfg(target_os = "windows")'.dependencies.windows61]
+package = "windows"
+version = "0.61"
+features = [
+    "Win32_Foundation",
+    "Win32_Graphics_Direct3D11",
+    "Win32_Graphics_Dxgi",
+]
+
 [lints.clippy]
 dbg_macro = "deny"
 declare_interior_mutable_const = "deny"
